{
  "name": "vcwl",
  "displayName": "VCWL",
  "description": "VCWL (Vibe Coded Web Language): highlighting, plus errors, lints, completion and formatting from `vcwl lsp`.",
  "version": "0.1.0",
  "publisher": "vcwl",
  "license": "MIT",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages", "Linters", "Formatters"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:vcwl"],
  "contributes": {
    "languages": [{ "id": "vcwl", "aliases": ["VCWL", "vcwl"], "extensions": [".vcwl"], "configuration": "./language-configuration.json" }],
    "grammars": [{ "language": "vcwl", "scopeName": "source.vcwl", "path": "./syntaxes/vcwl.tmLanguage.json" }],
    "configuration": {
      "title": "VCWL",
      "properties": {
        "vcwl.path": { "type": "string", "default": "vcwl", "description": "The vcwl binary (its `lsp` command serves this extension)." }
      }
    }
  }
}
