import "../model.vcwl"

export component TodoItem(todo: Todo) {
    event toggle(Int)
    event remove(Int)

    item {
        style {
            display: flex
            align: center
            justify: between
            gap: 12px
            padding: 10px 12px
            radius: 8px
            background: #161a20
        }
        style if todo.done {
            opacity: 0.6
            decoration: line-through
        }

        checkbox(label: todo.title, checked: todo.done) {
            on change(v) {
                emit toggle(todo.id)
            }
        }
        button("Delete", label: "Delete {todo.title}") {
            on click {
                emit remove(todo.id)
            }
            style Ghost
        }
    }
}

export style Ghost {
    background: transparent
    color: #9aa4b2
    border: 1px solid #2a313b
    radius: 6px
    padding: 4px 10px

    when hover {
        color: #f5f5f5
        border: 1px solid #6c7a8c
    }
}
