// The documentation pages: a sidebar, the page's blocks, and a small syntax highlighter
// written in VCWL (by words: good enough for docs, not a parser).

import "@web"
import "./theme.vcwl"
import "./docs_content.vcwl"

struct Word {
    n: Int,
    kind: Int,
    text: String,
}

fn find_page(slug: String) -> DocPage {
    let pages = doc_pages()
    pages[index_of(pages, slug)]
}

fn is_keyword(w: String) -> Bool {
    match w {
        "app" => true
        "component" => true
        "fn" => true
        "server" => true
        "extern" => true
        "let" => true
        "var" => true
        "state" => true
        "event" => true
        "emit" => true
        "on" => true
        "if" => true
        "else" => true
        "for" => true
        "in" => true
        "key" => true
        "match" => true
        "struct" => true
        "enum" => true
        "import" => true
        "export" => true
        "style" => true
        "when" => true
        "fetch" => true
        "await" => true
        "impl" => true
        "interface" => true
        "self" => true
        "Self" => true
        "as" => true
        "return" => true
        "export default" => true
        "const" => true
        "|>" => true
        _ => false
    }
}

fn word_kind(w: String, lang: String) -> Int {
    if lang == "sh" && (w == "vcwl" || w == "cargo" || w == "rustup" || w == "curl" || w == "tar" || w == "sudo") {
        5
    } else if is_keyword(w) {
        1
    } else if w.starts_with("\"") || w.ends_with("\"") || w.ends_with("\",") {
        3
    } else if w.ends_with("(") || w.contains("(") {
        2
    } else {
        0
    }
}

/// One line as colored words; a comment (`//` or `#`) runs to the end of the line.
fn highlight(line: String, lang: String) -> [Word] {
    var out: [Word] = []
    var comment = false
    var n = 0
    let indent = line.len() - line.trim().len()
    if indent > 0 {
        out = out.push(Word { n: 0, kind: 0, text: " ".repeat(indent) })
        n = 1
    }
    for w in line.trim().split(" ") {
        if w.starts_with("//") || (w.starts_with("#") && lang != "vcwl") {
            comment = true
        }
        let kind = if comment {
            4
        } else {
            word_kind(w, lang)
        }
        out = out.push(Word { n: n, kind: kind, text: w + " " })
        n += 1
    }
    out
}

fn numbered(lines: [String]) -> [Word] {
    var out: [Word] = []
    var n = 0
    for l in lines {
        out = out.push(Word { n: n, kind: 0, text: l })
        n += 1
    }
    out
}

/// Inline `code` spans: odd pieces of the text split on backticks.
fn pieces(text: String) -> [Word] {
    var out: [Word] = []
    var n = 0
    for s in text.split("`") {
        out = out.push(Word { n: n, kind: n % 2, text: s })
        n += 1
    }
    out
}

component Rich(text: String) {
    paragraph {
        style {
            margin: 0
            color: #c8c8c8
            line-height: 1.7
        }
        for w in pieces(text) key w.n {
            span(w.text) {
                style if w.kind == 1 {
                    font: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace
                    size: 14px
                    color: #b6ff6c
                    background: #1f2a1a
                    padding: 1px 5px
                    radius: 5px
                }
            }
        }
    }
}

component CodeLine(line: String, lang: String) {
    let words = highlight(line, lang)

    row {
        style {
            min-height: 21px
            color: #e6e6e6
        }
        for w in words key w.n {
            span(w.text) {
                style {
                    white-space: pre
                }
                style if w.kind == 1 {
                    color: #c792ea
                }
                style if w.kind == 2 {
                    color: #7cc4ff
                }
                style if w.kind == 3 {
                    color: #ffb86c
                }
                style if w.kind == 4 {
                    color: #6a6a6a
                    italic: yes
                }
                style if w.kind == 5 {
                    color: #b6ff6c
                }
            }
        }
    }
}

component CodeBlock(code: String, lang: String) {
    state copied: Bool = false

    article(label: "{lang} code") {
        style Window
        row(justify: between, align: center) {
            style Bar
            style Mono
            span(lang)
            button(if copied { "copied ✓" } else { "copy" }) {
                style Mono
                style {
                    padding: 2px 8px
                    size: 12px
                    color: #8a8a8a
                    background: #111111
                    border: 1px solid #333333
                    radius: 6px
                    cursor: pointer
                    transition: color 200ms ease-out
                    when hover {
                        color: #b6ff6c
                    }
                }
                on click {
                    fetch write_clipboard(code) {
                        Ok(_) => {
                            copied = true
                        }
                        Err(_) => {
                            copied = false
                        }
                    }
                }
            }
        }
        scroll {
            column {
                style Mono
                style {
                    padding: 14px 16px
                    size: 13px
                    line-height: 1.6
                }
                for l in numbered(code.split("\n")) key l.n {
                    CodeLine(line: l.text, lang: lang)
                }
            }
        }
    }
}

component SideLink(p: DocPage, on: Bool) {
    event picked

    link(p.title, to: "/docs/{p.slug}", current: on) {
        on click {
            emit picked
        }
        style {
            padding: 6px 10px
            radius: 8px
            color: #9a9a9a
            decoration: none
            size: 14px
            transition: background 200ms ease-out, color 200ms ease-out
            when hover {
                color: #ffffff
                background: #1a1a1a
            }
        }
        style if on {
            color: #b6ff6c
            background: #1f2a1a
        }
    }
}

export component Docs(slug: String) {
    state toc: Bool = false

    let page = find_page(slug)
    let pages = doc_pages()

    grid(gap: 40px) {
        style {
            columns: 220px 1fr
            padding: 24px 0 0
            when viewport < 820px {
                columns: 1fr
                gap: 20px
            }
        }
        // On phones the page list folds into a button, so the page itself comes first.
        button(if toc { "✕  {page.title}" } else { "☰  {page.title}" }, label: "Documentation pages") {
            style Mono
            style {
                display: none
                padding: 12px 14px
                size: 14px
                color: #b6ff6c
                background: #111111
                border: 1px solid #333333
                radius: 10px
                cursor: pointer
                when viewport < 820px {
                    display: block
                }
            }
            on click {
                toc = !toc
            }
        }
        nav(label: "Documentation") {
            style if !toc {
                when viewport < 820px {
                    display: none
                }
            }
            column(gap: 18px) {
                for g in ["Start", "Language", "Ecosystem"] key g {
                    column(gap: 2px) {
                        span(g) {
                            style Mono
                            style {
                                size: 11px
                                case: upper
                                letter-spacing: 1px
                                color: #6a6a6a
                                padding: 0 10px 6px
                            }
                        }
                        for p in pages key p.slug {
                            if p.group == g {
                                SideLink(p: p, on: p.slug == page.slug) {
                                    on picked {
                                        toc = false
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        article(label: page.title) {
            column(gap: 18px) {
                style {
                    min-width: 0
                    max-width: 760px
                    transition: opacity 400ms ease-out, transform 600ms spring
                    when appear {
                        opacity: 0
                        transform: translateY(12px)
                    }
                }
                span("// docs / {page.group}") {
                    style Pill
                    style Mono
                }
                heading(page.title, level: 1) {
                    style Title
                    style {
                        size: 44px
                    }
                }
                paragraph(page.blurb) {
                    style {
                        size: 18px
                        color: #9a9a9a
                    }
                }
                for b in page.blocks key b.n {
                    match b.kind {
                        "h" => heading(b.text, level: 2) {
                            style {
                                margin: 18px 0 0
                                size: 22px
                                color: #ffffff
                            }
                        }
                        "code" => CodeBlock(code: b.text, lang: b.lang)
                        "li" => row(gap: 10px) {
                            span("→") {
                                style Lime
                                style {
                                    padding: 3px 0 0
                                }
                            }
                            Rich(text: b.text)
                        }
                        "note" => aside {
                            style Glow
                            style {
                                padding: 14px 18px
                            }
                            Rich(text: b.text)
                        }
                        _ => Rich(text: b.text)
                    }
                }
                Pager(slug: page.slug)
            }
        }
    }
}

component Pager(slug: String) {
    let pages = doc_pages()
    let idx = index_of(pages, slug)
    let prev = pages.get(idx - 1)
    let next = pages.get(idx + 1)

    row(justify: between, gap: 12px) {
        style {
            padding: 28px 0 0
            margin: 18px 0 0
            border: 1px solid #00000000
        }
        match prev {
            Some(p) => link("← {p.title}", to: "/docs/{p.slug}") {
                style Ghost
            }
            None => span("")
        }
        match next {
            Some(p) => link("{p.title} →", to: "/docs/{p.slug}") {
                style Primary
            }
            None => link("Back to the hype →", to: "/") {
                style Primary
            }
        }
    }
}

fn index_of(pages: [DocPage], slug: String) -> Int {
    var i = 0
    var found = 0
    for p in pages {
        if p.slug == slug {
            found = i
        }
        i += 1
    }
    found
}
