}

component Pricing {
    state chosen: String = ""

    section(id: "pricing", label: "Pricing") {
        column(gap: 18px) {
            heading("Pricing", level: 2) {
                style Title
                style Reveal
            }
            grid(gap: 18px) {
                style ThreeCols
                for p in plans() key p.name {
                    article {
                        style Panel
                        style Reveal
                        style if p.name == "Startup" {
                            background: linear-gradient(160deg, #1f2a1a, #111111)
                            border: 1px solid #b6ff6c66
                        }
                        column(gap: 14px) {
                            row(justify: between, align: center) {
                                heading(p.name, level: 3) {
                                    style {
                                        margin: 0
                                        color: #ffffff
                                    }
                                }
                                if p.name == "Startup" {
                                    span("most vibes") {
                                        style Pill
                                        style Mono
                                    }
                                }
                            }
                            strong(p.price) {
                                style {
                                    size: 34px
                                    color: #b6ff6c
                                    letter-spacing: -1px
                                }
                            }
                            list {
                                style {
                                    padding: 0 0 0 18px
                                    color: #b5b5b5
                                }
                                for perk in p.perks key perk {
                                    item(perk)
                                }
                            }
                            button(p.cta) {
                                style Ghost
                                style if p.name == "Startup" {
                                    background: #b6ff6c
                                    color: #111111
                                }
                                on click {
                                    chosen = p.name
                                }
                            }
                        }
                    }
                }
            }
            if chosen != "" {
                paragraph("✓ {chosen} selected. Your invoice for $0.00 is on its way. Late fees apply (also $0.00).") {
                    style Mono
                    style Glow
                    style {
                        size: 14px
                        color: #b6ff6c
                        transition: opacity 400ms ease-out, transform 600ms bounce
                        when appear {
                            opacity: 0
                            transform: translateY(-12px)
                        }
                    }
                }
            }
        }
    }
}

component Honest {
    section(id: "real", label: "Honestly") {
        article {
            style Panel
            style Reveal
            column(gap: 14px) {
                span("// okay, for real for a second") {
                    style Pill
                    style Mono
                }
                heading("What VCWL actually is", level: 2) {
                    style Title
                }
                paragraph("An experimental language and compiler written in Rust, built for fun. Everything below exists and has tests; nothing here claims it's fast, safe or a good idea.") {
                    style {
                        color: #b5b5b5
                    }
                }
                list {
                    style {
                        padding: 0 0 0 20px
                        color: #d6d6d6
                    }
                    item("Statically typed source compiled to WasmGC; components, state and styles checked at compile time.")
                    item("A Rust renderer (also WebAssembly) that lays out and paints on a canvas, with an accessibility tree mirrored into the page.")
                    item("Server functions, fetch, routing, prerendering, fonts, 3D scenes with glTF models.")
                    item("A package manager whose registry is a git branch, with a security review before install.")
                    item("A linter, a language server, VS Code and Zed extensions, and an in-page debugger.")
                    item("extern fn and @web for calling JavaScript and the browser's Web APIs.")
                }
                paragraph("Performance: there are benchmarks in bench/, with their methods and limits. This page cites none of them, because this page is a bit.") {
                    style Fine
                }
                paragraph("WebAssembly sandboxes the module. It does not make an application secure; your bugs are still your bugs, just compiled.") {
                    style Fine
                }
            }
        }
    }
}

component Foot {
    footer {
        column(gap: 6px) {
            style Mono
            style Fine
            style {
                padding: 24px 0 0
                border: 1px solid #00000000
                size: 12px
            }
            text("// this entire page is written in VCWL and painted on a canvas. even this sentence.")
            text("// satire. no frameworks were killed; they're fine, they're thriving, leave them alone.")
            text("// © whenever. all vibes reserved.")
        }
    }
}
