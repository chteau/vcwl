// vcwl's GitHub Pages site. Every word of marketing on it is satire; the "Honestly" section is not.
app "VCWL — revolutionizing web development (no)" {
    capabilities {
        network: allow("self", "api.github.com", "raw.githubusercontent.com")
        storage: none
    }
}

import "@web"
import "./theme.vcwl"
import "./docs.vcwl"
import "./packages.vcwl"

struct Quote {
    who: String,
    role: String,
    text: String,
}

struct Site {
    name: String,
    url: String,
    blurb: String,
}

struct Plan {
    name: String,
    price: String,
    perks: [String],
    cta: String,
}

fn quotes() -> [Quote] {
    [
        Quote { who: "My mom", role: "Proud, confused", text: "He says it compiles. I said that's nice sweetie. I don't know what a compile is." },
        Quote { who: "A guy on the 7:42 train", role: "Unsolicited", text: "Rewrote our checkout in VCWL during my commute. Now nobody can check out. Including the bugs." },
        Quote { who: "Your linter", role: "Exhausted", text: "warning[unused-fn]: function `career` is never used." },
        Quote { who: "Senior Staff Principal Distinguished Thought Leader", role: "LinkedIn", text: "Agree? 🙏 VCWL taught me more about leadership than my three divorces. Repost if you're hiring." },
        Quote { who: "The canvas renderer", role: "Drawing everything by hand", text: "You people have the DOM. You had the DOM. Why am I doing this." },
        Quote { who: "A WebAssembly module", role: "Sandboxed", text: "Being memory safe at the bytecode level does not make your app secure. Please stop putting that on slides." },
    ]
}

fn showcase() -> [Site] {
    [
        Site { name: "MoonRb1x", url: "https://moonrb1x.github.io/", blurb: "A Roblox UI designer's portfolio. Shops, inventories and HUDs, painted on a canvas." },
    ]
}

fn hot_takes() -> [String] {
    [
        "CSS was a mistake. So we reimplemented it. On a canvas. By hand. Checkmate.",
        "Your framework has a virtual DOM. Ours has no DOM. That's 100% less DOM. Do the math.",
        "Every web language eventually becomes a JavaScript wrapper. We got there in Milestone 16. Speedrun.",
        "Type safety is when the compiler yells at you before your users do. We prefer both.",
        "We put the package registry on a git branch because buying a domain felt like commitment.",
        "Hydration is for plants. We prerender and pray.",
        "npm has two million packages. We have five, and one of them is is-odd. Quality over quantity, bitch.",
        "Server components? We have server functions. They're functions. On a server. Revolutionary.",
        "Our build tool has zero config because we forgot to add config.",
        "If it compiles it ships. If it doesn't compile, it ships anyway, as a vibe.",
    ]
}

struct Line {
    kind: Int,
    text: String,
}

/// A token of the code sample: 0 plain, 1 keyword, 2 name, 3 string, 4 comment, 5 accent.
struct Tok {
    kind: Int,
    text: String,
}

fn term_lines() -> [Line] {
    [
        Line { kind: 0, text: "$ vcwl new my-startup && cd my-startup" },
        Line { kind: 1, text: "created my-startup (series A pending)" },
        Line { kind: 0, text: "$ vcwl build" },
        Line { kind: 1, text: "  lexing vibes ........................ ok" },
        Line { kind: 1, text: "  type-checking feelings .............. ok" },
        Line { kind: 3, text: "  warning[unused-fn]: function `business_model` is never used" },
        Line { kind: 1, text: "  emitting WasmGC ..................... ok" },
        Line { kind: 4, text: "  index.html  app.wasm  render.wasm  vcwl.js" },
        Line { kind: 2, text: "✓ built dist/ — the web has been revolutionized*" },
        Line { kind: 1, text: "  * it has not" },
    ]
}

fn t(kind: Int, text: String) -> Tok {
    Tok { kind: kind, text: text }
}

struct CodeLine {
    n: Int,
    toks: [Tok],
}

fn code_lines() -> [CodeLine] {
    [
        CodeLine { n: 1, toks: [t(4, "// a whole app. yes, really.")] },
        CodeLine { n: 2, toks: [t(1, "app "), t(3, "\"Startup\""), t(0, " \{\}")] },
        CodeLine { n: 3, toks: [t(0, "")] },
        CodeLine { n: 4, toks: [t(1, "component "), t(2, "App"), t(0, " \{")] },
        CodeLine { n: 5, toks: [t(1, "    state "), t(0, "funding: "), t(5, "Int"), t(0, " = "), t(3, "0")] },
        CodeLine { n: 6, toks: [t(0, "")] },
        CodeLine { n: 7, toks: [t(2, "    column"), t(0, " \{")] },
        CodeLine { n: 8, toks: [t(2, "        heading"), t(0, "("), t(3, "\"Disrupting \{funding\}\""), t(0, ")")] },
        CodeLine { n: 9, toks: [t(2, "        button"), t(0, "("), t(3, "\"Pivot\""), t(0, ") \{")] },
        CodeLine { n: 10, toks: [t(1, "            style"), t(0, " \{ "), t(5, "corner"), t(0, ": squircle \}")] },
        CodeLine { n: 11, toks: [t(1, "            on "), t(2, "click"), t(0, " \{ funding "), t(1, "|>"), t(0, " burn \}")] },
        CodeLine { n: 12, toks: [t(0, "        \}")] },
        CodeLine { n: 13, toks: [t(0, "    \}")] },
        CodeLine { n: 14, toks: [t(0, "\}")] },
    ]
}

fn plans() -> [Plan] {
    [
        Plan { name: "Hobbyist", price: "$0", perks: ["The whole fucking language", "Five packages", "A changelog longer than your attention span"], cta: "Take it" },
        Plan { name: "Startup", price: "$0, angrily", perks: ["Same as Hobbyist", "We look at you disapprovingly", "A pitch deck that says 'AI'"], cta: "Disrupt" },
        Plan { name: "Enterprise", price: "Call us", perks: ["We will not pick up", "SSO (Sorry, Shit's Offline)", "A Gantt chart, for vibes"], cta: "Ring ring" },
    ]
}

component App {
    box {
        style Page
        link("Skip the bullshit", href: "#real") {
            style {
                position: fixed
                left: -999px
                top: 8px
                z: 50
                padding: 6px 10px
                background: #b6ff6c
                color: #111111
                when focus {
                    left: 8px
                }
            }
        }
        Nav()
        column {
            style Wrap
            main(id: "view") {
                routes {
                    "/" => Home()
                    "/docs" => Docs(slug: "install")
                    "/docs/install" => Docs(slug: "install")
                    "/docs/quickstart" => Docs(slug: "quickstart")
                    "/docs/tour" => Docs(slug: "tour")
                    "/docs/components" => Docs(slug: "components")
                    "/docs/styles" => Docs(slug: "styles")
                    "/docs/data" => Docs(slug: "data")
                    "/docs/3d" => Docs(slug: "3d")
                    "/docs/packages" => Docs(slug: "packages")
                    "/docs/interop" => Docs(slug: "interop")
                    "/docs/tools" => Docs(slug: "tools")
                    "/docs/deploy" => Docs(slug: "deploy")
                    "/packages" => Packages()
                    _ => NotFound()
                }
            }
            Foot()
        }
    }
}

component Home {
    column(gap: 72px) {
        Hero()
        StatusBar()
        Core()
        Problems()
        VibeCheck()
        Quotes()
        Showcase()
        Pricing()
        Honest()
    }
}

component NotFound {
    column(gap: 16px) {
        style {
            padding: 80px 0
        }
        span("404") {
            style Pill
            style Mono
        }
        heading("This page was vibe coded out of existence.", level: 1) {
            style Shout
        }
        link("Go home, you're drunk", to: "/") {
            style Primary
            style {
                align-self: start
            }
        }
    }
}

component Nav {
    state open: Bool = false

    nav(label: "Site") {
        style Mono
        style {
            max-width: 1120px
            margin: 0 auto
            padding: 18px 24px
            size: 13px
            when viewport < 700px {
                padding: 14px 16px
            }
        }
        row(justify: between, align: center) {
            row(gap: 8px, align: center) {
                image(src: "logo.svg", alt: "") {
                    style {
                        width: 26px
                        height: 26px
                        transition: transform 600ms spring
                        when hover {
                            transform: rotate(-12deg) scale(1.15)
                        }
                    }
                }
                link("vcwl", to: "/") {
                    style {
                        color: #ffffff
                        weight: 700
                        decoration: none
                    }
                    on click {
                        open = false
                    }
                }
                span("v0.1.0 (vibes edition)") {
                    style Muted
                    style {
                        when viewport < 500px {
                            display: none
                        }
                    }
                }
            }
            row(gap: 18px, align: center) {
                style {
                    when viewport < 700px {
                        display: none
                    }
                }
                NavLinks()
            }
            // Phones get a menu button instead of a row of links.
            button(if open { "✕ close" } else { "☰ menu" }, label: "Menu") {
                style Mono
                style {
                    display: none
                    padding: 8px 12px
                    size: 13px
                    color: #e6e6e6
                    background: #111111
                    border: 1px solid #333333
                    radius: 8px
                    cursor: pointer
                    when viewport < 700px {
                        display: block
                    }
                }
                style if open {
                    color: #b6ff6c
                    border: 1px solid #b6ff6c
                }
                on click {
                    open = !open
                }
            }
        }
        if open {
            column(gap: 4px) {
                style {
                    padding: 14px 0 6px
                    size: 16px
                    when viewport >= 700px {
                        display: none
                    }
                    transition: opacity 250ms ease-out, transform 400ms spring
                    when appear {
                        opacity: 0
                        transform: translateY(-8px)
                    }
                }
                NavLinks() {
                    on picked {
                        open = false
                    }
                }
            }
        }
    }
}

/// The site's main links; on phones they stack in the menu, with room for a thumb.
component NavLinks {
    event picked

    link("docs", to: "/docs/install", current: route.starts_with("/docs")) {
        style NavLink
        on click {
            emit picked
        }
    }
    link("packages", to: "/packages", current: route == "/packages") {
        style NavLink
        on click {
            emit picked
        }
    }
    link("github ↗", href: "https://github.com/chteau/vcwl") {
        style NavLink
        on click {
            emit picked
        }
    }
    link("download", href: "https://github.com/chteau/vcwl/releases/latest") {
        style NavLink
        on click {
            emit picked
        }
    }
}

style NavLink {
    color: #8a8a8a
    decoration: none
    when viewport < 700px {
        padding: 10px 0
        border-bottom: 1px solid #222222
    }
    transition: color 200ms ease-out
    when hover {
        color: #b6ff6c
    }
}

component Hero {
    state adopted: Int = 0

    header {
        grid(gap: 36px) {
            style TwoCols
            style {
                align: center
            }
            column(gap: 20px) {
                style Reveal
                span("// new: the |> operator. you're welcome.") {
                    style Pill
                    style Mono
                }
                heading("VCWL is going to revolutionize web development.", level: 1) {
                    style Shout
                }
                paragraph("The Vibe Coded Web Language compiles to WebAssembly, paints your website on a canvas like Flash never died, and ships with a package manager nobody asked for. Thought leaders are calling it \"a language\".") {
                    style {
                        size: 18px
                        color: #b5b5b5
                    }
                }
                paragraph("// it will not revolutionize shit. it's a joke project. it does compile, which is worse.") {
                    style Mono
                    style Fine
                }
                row(gap: 12px, wrap: yes, align: center) {
                    button("Adopt in production") {
                        style Primary
                        on click {
                            adopted += 1
                            if adopted == 1 {
                                alert("Bold move. Your CTO has been notified. They are crying.")
                            } else {
                                alert("You've adopted it {adopted} times. That's not how adoption works. Please seek help.")
                            }
                        }
                    }
                    link("Read the docs", to: "/docs/install") {
                        style Ghost
                    }
                }
            }
            Terminal()
        }
    }
}

component Terminal {
    state shown: Int = 0

    let lines = term_lines()

    on mount {
        for i in 0..lines.len() {
            fetch sleep(500 + i * 420) {
                Ok(_) => {
                    shown += 1
                }
                Err(_) => {
                    shown = lines.len()
                }
            }
        }
    }

    article(label: "A terminal running vcwl build") {
        style Window
        style Reveal2
        row(gap: 6px, align: center) {
            style Bar
            style Mono
            span("●") {
                style {
                    color: #ff5f57
                }
            }
            span("●") {
                style {
                    color: #ffb86c
                }
            }
            span("●") {
                style Lime
            }
            span("  ~/my-startup — zsh")
        }
        column(gap: 2px) {
            style Mono
            style {
                padding: 16px 18px 20px
                size: 13px
                min-height: 290px
            }
            for l in lines.slice(0, shown) key l.text {
                span(l.text) {
                    style {
                        white-space: pre-wrap
                        color: #8a8a8a
                        transition: opacity 300ms ease-out, transform 400ms spring
                        when appear {
                            opacity: 0
                            transform: translateX(-8px)
                        }
                    }
                    style if l.kind == 0 {
                        color: #e6e6e6
                    }
                    style if l.kind == 2 {
                        color: #b6ff6c
                        weight: 700
                    }
                    style if l.kind == 3 {
                        color: #ffb86c
                    }
                    style if l.kind == 4 {
                        color: #7cc4ff
                    }
                }
            }
            if shown < lines.len() {
                span("▌") {
                    style Lime
                }
            }
        }
    }
}

component StatusBar {
    row(gap: 24px, wrap: yes, justify: center) {
        style Mono
        style {
            padding: 12px 18px
            background: #111111cc
            border: 1px solid #333333
            radius: 18px
            size: 12px
            color: #8a8a8a
        }
        style Reveal
        span("● 0 errors") {
            style Lime
        }
        span("● 0 warnings")
        span("● 0 users") {
            style {
                color: #ffb86c
            }
        }
        span("● 0 dependencies (we wrote them all, badly)")
        span("● no DOM was harmed") {
            style {
                color: #7cc4ff
            }
        }
    }
}

component Core {
    section(id: "core", label: "The Vibe Core") {
        column(gap: 22px) {
            span("// fig. 1") {
                style Pill
                style Mono
            }
            heading("A whole app, and the 3D engine nobody needed.", level: 2) {
                style Title
                style Reveal
            }
            grid(gap: 20px) {
                style TwoCols
                article(label: "Example VCWL code") {
                    style Window
                    style Reveal
                    row {
                        style Bar
                        style Mono
                        span("src/main.vcwl")
                    }
                    column {
                        style Mono
                        style {
                            padding: 16px 18px
                            size: 13px
                        }
                        for line in code_lines() key line.n {
                            row {
                                for tok in line.toks key tok.text {
                                    span(tok.text) {
                                        style {
                                            white-space: pre
                                            color: #e6e6e6
                                            min-height: 20px
                                        }
                                        style if tok.kind == 1 {
                                            color: #c792ea
                                        }
                                        style if tok.kind == 2 {
                                            color: #7cc4ff
                                        }
                                        style if tok.kind == 3 {
                                            color: #ffb86c
                                        }
                                        style if tok.kind == 4 {
                                            color: #6a6a6a
                                            italic: yes
                                        }
                                        style if tok.kind == 5 {
                                            color: #b6ff6c
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                column(gap: 10px) {
                    style Reveal2
                    scene(label: "The Vibe Core: a lime torus orbiting a blue box, with an orange moon", camera: vec3(0.0, 1.4, 5.5), orbit: true, shadows: true, background: "#111111") {
                        style {
                            height: 380px
                            border: 1px solid #333333
                            radius: 14px
                            corner: squircle
                        }
                        light(kind: "ambient", intensity: 0.35)
                        light(kind: "point", position: vec3(2.5, 3.5, 2.5), color: "#ffffff", intensity: 1.2)
                        group(spin: vec3(0.0, 40.0, 0.0)) {
                            mesh(shape: "box", label: "The compiler (it's a box)", size: vec3(0.8, 0.8, 0.8), rotation: vec3(20.0, 30.0, 0.0), color: "#7cc4ff")
                            group(spin: vec3(90.0, 0.0, 30.0)) {
                                mesh(shape: "torus", label: "The vibes", size: vec3(2.6, 2.6, 2.6), color: "#b6ff6c")
                            }
                        }
                        group(spin: vec3(0.0, -70.0, 0.0)) {
                            mesh(shape: "sphere", label: "A moon of technical debt", position: vec3(2.0, 0.6, 0.0), size: vec3(0.35, 0.35, 0.35), color: "#ffb86c")
                            mesh(shape: "cone", label: "A party hat", position: vec3(-2.0, -0.2, 0.0), size: vec3(0.4, 0.5, 0.4), color: "#c792ea")
                        }
                        mesh(shape: "plane", label: "The floor (load-bearing)", position: vec3(0.0, -1.6, 0.0), size: vec3(6.0, 1.0, 6.0), color: "#1d1d1d")
                    }
                    paragraph("Drag it. It's WebGL with shadows. We wrote a 3D engine for a joke and we need help.") {
                        style Fine
                    }
                }
            }
        }
    }
}

component Problems {
    section(label: "Problems") {
        grid(gap: 20px) {
            style TwoCols
            article {
                style Panel
                style Reveal
                column(gap: 12px) {
                    span("✓ solves") {
                        style Pill
                        style Mono
                    }
                    list {
                        style {
                            padding: 0 0 0 20px
                            color: #c8c8c8
                        }
                        item("Having too much free time")
                        item("Not knowing what a WasmGC struct is")
                        item("Your website being selectable, searchable and cheap to render")
                        item("The crushing silence of an empty changelog")
                    }
                }
            }
            article {
                style Panel
                style Reveal2
                column(gap: 12px) {
                    span("✗ causes") {
                        style Pill
                        style Mono
                        style {
                            background: #2a1d12
                            color: #ffb86c
                            border: 1px solid #ffb86c44
                        }
                    }
                    list {
                        style {
                            padding: 0 0 0 20px
                            color: #c8c8c8
                        }
                        item("All of the above, but in production")
                        item("Explaining to your manager why the text is drawn on a canvas")
                        item("An irrational urge to put grain on everything")
                        item("Arguments about whether |> is a language feature or a lifestyle")
                    }
                }
            }
        }
    }
}

component VibeCheck {
    state take: String = "Press the button. Receive wisdom. Regret nothing."
    state score: Int = 0
    state checks: Int = 0

    let verdict = if checks == 0 {
        "unmeasured"
    } else if score < 20 {
        "catastrophic (have you tried a rewrite?)"
    } else if score < 60 {
        "mid. very mid."
    } else if score < 95 {
        "immaculate"
    } else {
        "illegal in 14 countries"
    }

    section(label: "Vibe check") {
        article {
            style Glow
            style Reveal
            column(gap: 18px) {
                span("// interactive. written in vcwl. calls crypto through @web.") {
                    style Pill
                    style Mono
                }
                heading("The Hot Take Generator™", level: 2) {
                    style Title
                }
                paragraph("“{take}”") {
                    style {
                        size: 22px
                        color: #ffffff
                    }
                }
                column(gap: 6px) {
                    row(justify: between) {
                        style Mono
                        style Fine
                        span("vibe score")
                        span("{score}/100 · {verdict}") {
                            style Lime
                        }
                    }
                    box {
                        style {
                            height: 8px
                            background: #1d1d1d
                            radius: 999px
                            overflow: hidden
                        }
                        box {
                            style {
                                height: 8px
                                background: linear-gradient(90deg, #7cc4ff, #b6ff6c)
                                radius: 999px
                            }
                            style bind width: score %
                        }
                    }
                }
                row(gap: 14px, wrap: yes, align: center) {
                    button("Generate hot take") {
                        style Primary
                        on click {
                            let all = hot_takes()
                            take = all.get(random_int(0, all.len() - 1)).unwrap_or("Error: take too hot")
                            score = random_int(0, 100)
                            checks += 1
                        }
                    }
                    span(if checks > 4 { "{checks} takes. That's a newsletter. Please don't." } else { "" }) {
                        style Fine
                    }
                }
            }
        }
    }
}

component Quotes {
    section(label: "Testimonials") {
        column(gap: 18px) {
            heading("What people are saying", level: 2) {
                style Title
                style Reveal
            }
            paragraph("All testimonials are made up. That's what makes them authentic in this industry.") {
                style Fine
            }
            grid(gap: 18px) {
                style ThreeCols
                for q in quotes() key q.who {
                    article {
                        style Panel
                        style Reveal
                        column(gap: 14px) {
                            paragraph("“{q.text}”") {
                                style {
                                    color: #d6d6d6
                                }
                            }
                            row(gap: 10px, align: center) {
                                box {
