                                            size: 12px
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component Showcase {
    section(id: "showcase", label: "Showcase") {
        column(gap: 18px) {
            heading("Made with VCWL", level: 2) {
