// VCWL standard prelude. Compiled into every program; unused functions are removed.
// Functions named `<type>_<name>` provide methods: `s.len()` resolves to `str_len(s)`.
// Only this file may call `__` intrinsics.

export enum Option<T> {
    Some(T),
    None,
}

export enum Result<T, E> {
    Ok(T),
    Err(E),
}

/// Why a `fetch` failed. `Status` carries the HTTP status and the response text; `Decode`
/// says where the response did not match the expected type.
export enum HttpError {
    Network(String),
    Timeout,
    Status(Int, String),
    Decode(String),
}

// ----- strings (UTF-8 bytes) -----

fn str_concat(a: String, b: String) -> String {
    let la = __str_len(a)
    let lb = __str_len(b)
    let out = __str_alloc(la + lb)
    __str_copy(out, 0, a, 0, la)
    __str_copy(out, la, b, 0, lb)
    out
}

fn str_eq(a: String, b: String) -> Bool {
    let n = __str_len(a)
    if n != __str_len(b) {
        return false
    }
    var i = 0
    while i < n {
        if __str_byte(a, i) != __str_byte(b, i) {
            return false
        }
        i += 1
    }
    true
}

fn str_len(s: String) -> Int {
    __str_len(s)
}

fn str_is_empty(s: String) -> Bool {
    __str_len(s) == 0
}

fn str_slice(s: String, start: Int, end: Int) -> String {
    let n = __str_len(s)
    let a = start.clamp(0, n)
    let b = end.clamp(a, n)
    let out = __str_alloc(b - a)
    __str_copy(out, 0, s, a, b - a)
    out
}

fn str_index_of(s: String, needle: String) -> Int? {
    let n = __str_len(s)
    let m = __str_len(needle)
    var i = 0
    while i + m <= n {
        var j = 0
        while j < m && __str_byte(s, i + j) == __str_byte(needle, j) {
            j += 1
        }
        if j == m {
            return Some(i)
        }
        i += 1
    }
    None
}

fn str_contains(s: String, needle: String) -> Bool {
    s.index_of(needle).is_some()
}

fn str_starts_with(s: String, prefix: String) -> Bool {
    __str_len(prefix) <= __str_len(s) && s.slice(0, __str_len(prefix)) == prefix
}

fn str_ends_with(s: String, suffix: String) -> Bool {
    let n = __str_len(s)
    let m = __str_len(suffix)
    m <= n && s.slice(n - m, n) == suffix
}

fn is_space(c: Int) -> Bool {
    c == 32 || c == 9 || c == 10 || c == 13
}

fn str_trim(s: String) -> String {
    var a = 0
    var b = __str_len(s)
    while a < b && is_space(__str_byte(s, a)) {
        a += 1
    }
    while b > a && is_space(__str_byte(s, b - 1)) {
        b -= 1
    }
    s.slice(a, b)
}

fn map_ascii(s: String, lo: Int, hi: Int, delta: Int) -> String {
    let n = __str_len(s)
    let out = __str_alloc(n)
    for i in 0..n {
        let c = __str_byte(s, i)
        __str_set_byte(out, i, if c >= lo && c <= hi { c + delta } else { c })
    }
    out
}

fn str_to_upper(s: String) -> String {
    map_ascii(s, 97, 122, -32)
}

fn str_to_lower(s: String) -> String {
    map_ascii(s, 65, 90, 32)
}

fn str_repeat(s: String, times: Int) -> String {
    var out = ""
    for i in 0..times {
        out = out + s
    }
    out
}

fn str_split(s: String, sep: String) -> [String] {
    var parts: [String] = []
    var rest = s
    if __str_len(sep) == 0 {
        return [s]
    }
    var going = true
    while going {
        match rest.index_of(sep) {
            Some(i) => {
                parts = parts.push(rest.slice(0, i))
                rest = rest.slice(i + __str_len(sep), __str_len(rest))
            }
            None => {
                going = false
            }
        }
    }
    parts.push(rest)
}

/// Parses an optionally signed decimal integer; `None` on any other input or overflow.
fn str_parse_int(s: String) -> Int? {
    let t = s.trim()
    let n = __str_len(t)
    if n == 0 {
        return None
    }
    var i = 0
    var neg = false
    let first = __str_byte(t, 0)
    if first == 45 || first == 43 {
        neg = first == 45
        i = 1
        if n == 1 {
            return None
        }
    }
    // Accumulate negatively so that the minimum Int parses.
    var acc = 0
    while i < n {
        let c = __str_byte(t, i)
        if c < 48 || c > 57 {
            return None
        }
        if acc < -922337203685477580 || acc == -922337203685477580 && c - 48 > 8 {
            return None
        }
        acc = acc * 10 - (c - 48)
        i += 1
    }
    if neg {
        Some(acc)
    } else if acc == -9223372036854775807 - 1 {
        None
    } else {
        Some(-acc)
    }
}

// ----- numbers -----

fn int_to_string(n: Int) -> String {
    if n == 0 {
        return "0"
    }
    let digits = __str_alloc(20)
    var i = 20
    // Work with non-positive values so the minimum Int is representable.
    var x = if n < 0 { n } else { -n }
    while x != 0 {
        i -= 1
        __str_set_byte(digits, i, 48 - x % 10)
        x = x / 10
    }
    if n < 0 {
        i -= 1
        __str_set_byte(digits, i, 45)
    }
    let out = __str_alloc(20 - i)
    __str_copy(out, 0, digits, i, 20 - i)
    out
}

fn int_to_float(n: Int) -> Float {
    __float_from_int(n)
}

fn int_abs(n: Int) -> Int {
    if n < 0 { -n } else { n }
}

fn int_min(a: Int, b: Int) -> Int {
    if a < b { a } else { b }
}

fn int_max(a: Int, b: Int) -> Int {
    if a > b { a } else { b }
}

fn int_clamp(n: Int, lo: Int, hi: Int) -> Int {
    if n < lo { lo } else if n > hi { hi } else { n }
}

fn float_to_string(f: Float) -> String {
    __float_to_string(f)
}

/// Truncates toward zero; saturates at the Int range, NaN becomes 0.
fn float_to_int(f: Float) -> Int {
    __int_from_float(f)
}

fn float_floor(f: Float) -> Float {
    __float_floor(f)
}

fn float_ceil(f: Float) -> Float {
    __float_ceil(f)
}

/// Rounds half away from zero.
fn float_round(f: Float) -> Float {
    if f < 0.0 { -__float_floor(-f + 0.5) } else { __float_floor(f + 0.5) }
}

fn float_sqrt(f: Float) -> Float {
    __float_sqrt(f)
}

fn float_abs(f: Float) -> Float {
    if f < 0.0 { -f } else { f }
}

fn float_min(a: Float, b: Float) -> Float {
    if a < b { a } else { b }
}

fn float_max(a: Float, b: Float) -> Float {
    if a > b { a } else { b }
}

fn bool_to_string(b: Bool) -> String {
    if b { "true" } else { "false" }
}

// ----- arrays (immutable: updates return new arrays) -----

fn arr_len<T>(a: [T]) -> Int {
    __arr_len(a)
}

fn arr_is_empty<T>(a: [T]) -> Bool {
    __arr_len(a) == 0
}

fn arr_get<T>(a: [T], i: Int) -> T? {
    if i >= 0 && i < __arr_len(a) { Some(a[i]) } else { None }
}

fn arr_first<T>(a: [T]) -> T? {
    a.get(0)
}

fn arr_last<T>(a: [T]) -> T? {
    a.get(__arr_len(a) - 1)
}

// Amortized O(1) when `a` is the newest array built from its storage (see `vec_type`).
fn arr_push<T>(a: [T], x: T) -> [T] {
    __arr_push(a, x)
}

fn arr_set<T>(a: [T], i: Int, x: T) -> [T] {
    let n = __arr_len(a)
    if i < 0 || i >= n {
        __panic("array index out of bounds")
    }
    let out = __arr_alloc(n, x)
    __arr_copy(out, 0, a, 0, n)
    __arr_set(out, i, x)
    out
}

fn arr_remove_at<T>(a: [T], i: Int) -> [T] {
    let n = __arr_len(a)
    if i < 0 || i >= n {
        __panic("array index out of bounds")
    }
    let out = __arr_alloc(n - 1, a[0])
    __arr_copy(out, 0, a, 0, i)
    __arr_copy(out, i, a, i + 1, n - i - 1)
    out
}

fn arr_concat<T>(a: [T], b: [T]) -> [T] {
    let la = __arr_len(a)
    let lb = __arr_len(b)
    if la == 0 {
        return b
    }
    var out = a
    for x in b {
        out = __arr_push(out, x)
    }
    out
}

fn arr_slice<T>(a: [T], start: Int, end: Int) -> [T] {
    let n = __arr_len(a)
    let s = start.clamp(0, n)
    let e = end.clamp(s, n)
    if e == s {
        return []
    }
    let out = __arr_alloc(e - s, a[s])
    __arr_copy(out, 0, a, s, e - s)
    out
}

fn arr_reverse<T>(a: [T]) -> [T] {
    let n = __arr_len(a)
    if n == 0 {
        return a
    }
    let out = __arr_alloc(n, a[0])
    for i in 0..n {
        __arr_set(out, i, a[n - 1 - i])
    }
    out
}

fn arr_map<T, U>(a: [T], f: fn(T) -> U) -> [U] {
    let n = __arr_len(a)
    if n == 0 {
        return []
    }
    let out = __arr_alloc(n, f(a[0]))
    for i in 1..n {
        __arr_set(out, i, f(a[i]))
    }
    out
}

fn arr_filter<T>(a: [T], keep: fn(T) -> Bool) -> [T] {
    let n = __arr_len(a)
    if n == 0 {
        return a
    }
    let out = __arr_alloc(n, a[0])
    var count = 0
    for x in a {
        if keep(x) {
            __arr_set(out, count, x)
            count += 1
        }
    }
    let res = __arr_alloc(count, a[0])
    __arr_copy(res, 0, out, 0, count)
    res
}

fn arr_fold<T, A>(a: [T], init: A, f: fn(A, T) -> A) -> A {
    var acc = init
    for x in a {
        acc = f(acc, x)
    }
    acc
}

fn arr_each<T>(a: [T], f: fn(T)) {
    for x in a {
        f(x)
    }
}

fn arr_any<T>(a: [T], test: fn(T) -> Bool) -> Bool {
    for x in a {
        if test(x) {
            return true
        }
    }
    false
}

fn arr_all<T>(a: [T], test: fn(T) -> Bool) -> Bool {
    for x in a {
        if !test(x) {
            return false
        }
    }
    true
}

fn arr_find<T>(a: [T], test: fn(T) -> Bool) -> T? {
    for x in a {
        if test(x) {
            return Some(x)
        }
    }
    None
}

// Stable bottom-up merge sort; `less(a, b)` says whether `a` goes before `b`.
fn arr_sort_by<T>(a: [T], less: fn(T, T) -> Bool) -> [T] {
    let n = __arr_len(a)
    if n < 2 {
        return a
    }
    var src = __arr_alloc(n, a[0])
    __arr_copy(src, 0, a, 0, n)
    var dst = __arr_alloc(n, a[0])
    var width = 1
    while width < n {
        var lo = 0
        while lo < n {
            let mid = (lo + width).min(n)
            let hi = (lo + 2 * width).min(n)
            var i = lo
            var j = mid
            for k in lo..hi {
                if i < mid && (j >= hi || !less(src[j], src[i])) {
                    __arr_set(dst, k, src[i])
                    i += 1
                } else {
                    __arr_set(dst, k, src[j])
                    j += 1
                }
            }
            lo = hi
        }
        let t = src
        src = dst
        dst = t
        width = width * 2
    }
    src
}

fn arr_join(a: [String], sep: String) -> String {
    var out = ""
    for i in 0..__arr_len(a) {
        if i > 0 {
            out = out + sep
        }
        out = out + a[i]
    }
    out
}

fn arr_sum(a: [Int]) -> Int {
    var total = 0
    for x in a {
        total += x
    }
    total
}

// ----- Option / Result -----

fn opt_is_some<T>(o: T?) -> Bool {
    match o {
        Some(_) => true,
        None => false,
    }
}

fn opt_is_none<T>(o: T?) -> Bool {
    !o.is_some()
}

fn opt_unwrap_or<T>(o: T?, fallback: T) -> T {
    match o {
        Some(v) => v,
        None => fallback,
    }
}

fn res_is_ok<T, E>(r: Result<T, E>) -> Bool {
    match r {
        Ok(_) => true,
        Err(_) => false,
    }
}

fn res_is_err<T, E>(r: Result<T, E>) -> Bool {
    !r.is_ok()
}

fn res_unwrap_or<T, E>(r: Result<T, E>, fallback: T) -> T {
    match r {
        Ok(v) => v,
        Err(_) => fallback,
    }
}

fn res_ok<T, E>(r: Result<T, E>) -> T? {
    match r {
        Ok(v) => Some(v),
        Err(_) => None,
    }
}

// ----- HTTP and JSON (used by `fetch`; decoders for other types are generated) -----

fn http_message(e: HttpError) -> String {
    match e {
        Network(m) => "network error: " + m,
        Timeout => "the request timed out",
        Status(code, _) => "HTTP status {code}",
        Decode(m) => "unexpected response: " + m,
    }
}

// Host result kinds: 1 network error, 2 timeout, 3 HTTP status, 4 invalid JSON.
fn http_error(kind: Int, status: Int, len: Int) -> HttpError {
    let text = __str_from_io(len)
    match kind {
        2 => Timeout,
        3 => Status(status, text),
        4 => Decode(text),
        _ => Network(text),
    }
}

fn json_kind_name(h: Int) -> String {
    match __json_kind(h) {
        0 => "null",
        1 => "a boolean",
        2 => "a number",
        3 => "a string",
        4 => "an array",
        5 => "an object",
        _ => "nothing",
    }
}

// Decoding errors start with ": "; enclosing decoders prepend `.field` or `[index]`.
fn json_expected(what: String, h: Int) -> String {
    ": expected " + what + ", found " + json_kind_name(h)
}

fn json_bool(h: Int) -> Result<Bool, String> {
    if __json_kind(h) == 1 { Ok(__json_bool(h)) } else { Err(json_expected("a boolean", h)) }
}

fn json_float(h: Int) -> Result<Float, String> {
    if __json_kind(h) == 2 { Ok(__json_num(h)) } else { Err(json_expected("a number", h)) }
}

fn json_int(h: Int) -> Result<Int, String> {
    if __json_kind(h) != 2 {
        return Err(json_expected("an integer", h))
    }
    let f = __json_num(h)
    // Only integers that a JSON number (an f64) represents exactly are accepted.
    if f != f.floor() || f.abs() > 9007199254740991.0 {
        return Err(": expected an integer, found " + f.to_string())
    }
    Ok(f.to_int())
}

fn json_string(h: Int) -> Result<String, String> {
    if __json_kind(h) == 3 { Ok(__json_str(h)) } else { Err(json_expected("a string", h)) }
}

fn json_float_text(f: Float) -> String {
    __json_num_text(f)
}

fn json_quote(s: String) -> String {
    __json_quote(s)
}

// ----- server functions (`env`, `load`, `save` and `remove` call these) -----

fn server_env(name: String) -> String? {
    let n = __env(name)
    if n < 0 { None } else { Some(__str_from_io(n)) }
}

fn server_load_text(key: String) -> String? {
    let n = __store_get(key)
    if n < 0 { None } else { Some(__str_from_io(n)) }
}

fn server_save_text(key: String, value: String) {
    // Both strings travel in one buffer: the key's length, then key and value.
    __store_set(__str_len(key), key + value)
}

// ----- JavaScript (`extern fn`) -----

fn extern_call_handle(name: String, args: String) -> Int {
    // Name and arguments travel in one buffer, like `server_save_text`; a negative result is
    // the length of the error message, minus one.
    let h = __js_call(__str_len(name), name + args)
    if h < 0 {
        __panic("JavaScript function `" + name + "` threw: " + __str_from_io(-1 - h))
    }
    h
}

fn server_remove(key: String) {
    __store_delete(key)
}

// ----- 3D -----

/// A point or direction in 3D (scene, mesh, light and group arguments).
export struct Vec3 {
    x: Float,
    y: Float,
    z: Float,
}

export fn vec3(x: Float, y: Float, z: Float) -> Vec3 {
    Vec3 { x: x, y: y, z: z }
}

fn vec3_text(v: Vec3) -> String {
    "{v.x} {v.y} {v.z}"
}

// ----- tuples -----
// `(a, b)` is sugar for `Tuple2(a, b)`, `(A, B)` for `Tuple2<A, B>`, `t.0` for a match.

export enum Tuple2<A, B> {
    Tuple2(A, B),
}

export enum Tuple3<A, B, C> {
    Tuple3(A, B, C),
}

export enum Tuple4<A, B, C, D> {
    Tuple4(A, B, C, D),
}

// ----- route parameters -----

/// Whether `path` matches the route `pat`, whose `:name` segments match any one non-empty segment.
fn route_matches(pat: String, path: String) -> Bool {
    let ps = pat.split("/")
    let xs = path.split("/")
    if ps.len() != xs.len() {
        return false
    }
    var i = 0
    while i < ps.len() {
        let p = ps[i]
        let x = xs[i]
        if p.starts_with(":") {
            if x.is_empty() {
                return false
            }
        } else if p != x {
            return false
        }
        i = i + 1
    }
    true
}

/// The segment of `path` matched by `:name` in the route `pat` (`""` when there is none).
fn route_param(pat: String, path: String, name: String) -> String {
    let ps = pat.split("/")
    let xs = path.split("/")
    var i = 0
    while i < ps.len() && i < xs.len() {
        if ps[i] == ":" + name {
            return xs[i]
        }
        i = i + 1
    }
    ""
}

fn tup2__0<A, B>(t: Tuple2<A, B>) -> A {
    match t {
        Tuple2(a, _) => a,
    }
}

fn tup2__1<A, B>(t: Tuple2<A, B>) -> B {
    match t {
        Tuple2(_, b) => b,
    }
}

fn tup3__0<A, B, C>(t: Tuple3<A, B, C>) -> A {
    match t {
        Tuple3(a, _, _) => a,
    }
}

fn tup3__1<A, B, C>(t: Tuple3<A, B, C>) -> B {
    match t {
        Tuple3(_, b, _) => b,
    }
}

fn tup3__2<A, B, C>(t: Tuple3<A, B, C>) -> C {
    match t {
        Tuple3(_, _, c) => c,
    }
}

fn tup4__0<A, B, C, D>(t: Tuple4<A, B, C, D>) -> A {
    match t {
        Tuple4(a, _, _, _) => a,
    }
}

fn tup4__1<A, B, C, D>(t: Tuple4<A, B, C, D>) -> B {
    match t {
        Tuple4(_, b, _, _) => b,
    }
}

fn tup4__2<A, B, C, D>(t: Tuple4<A, B, C, D>) -> C {
    match t {
        Tuple4(_, _, c, _) => c,
    }
}

fn tup4__3<A, B, C, D>(t: Tuple4<A, B, C, D>) -> D {
    match t {
        Tuple4(_, _, _, d) => d,
    }
}

// ----- UTF-8 code points -----

fn utf8_width(b: Int) -> Int {
    if b < 128 {
        1
    } else if b < 224 {
        2
    } else if b < 240 {
        3
    } else {
        4
    }
}

fn str_chars(s: String) -> [String] {
    let n = __str_len(s)
    var out: [String] = []
    var i = 0
    while i < n {
        let w = utf8_width(__str_byte(s, i))
        out = out.push(s.slice(i, i + w))
        i += w
    }
    out
}

fn str_char_len(s: String) -> Int {
    let n = __str_len(s)
    var count = 0
    var i = 0
    while i < n {
        i += utf8_width(__str_byte(s, i))
        count += 1
    }
    count
}

/// Code point indices, clamped to the string.
fn str_char_slice(s: String, start: Int, end: Int) -> String {
    let cs = s.chars()
    let a = start.clamp(0, cs.len())
    let b = end.clamp(a, cs.len())
    cs.slice(a, b).join("")
}

// ----- Map and Set (String keys, kept sorted; JSON objects only have string keys) -----

export struct Map<V> {
    keys: [String],
    vals: [V],
}

export struct Set {
    members: [String],
}

export fn empty_map<V>() -> Map<V> {
    Map { keys: [], vals: [] }
}

export fn empty_set() -> Set {
    Set { members: [] }
}

fn str_compare(a: String, b: String) -> Int {
    let la = __str_len(a)
    let lb = __str_len(b)
    let n = la.min(lb)
    var i = 0
    while i < n {
        let x = __str_byte(a, i)
        let y = __str_byte(b, i)
        if x != y {
            return if x < y { -1 } else { 1 }
        }
        i += 1
    }
    if la < lb { -1 } else if la > lb { 1 } else { 0 }
}

fn lower_bound(keys: [String], k: String) -> Int {
    var lo = 0
    var hi = keys.len()
    while lo < hi {
        let mid = (lo + hi) / 2
        if str_compare(keys[mid], k) < 0 {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    lo
}

fn arr_insert<T>(a: [T], i: Int, x: T) -> [T] {
    a.slice(0, i).push(x).concat(a.slice(i, a.len()))
}

fn map_get<V>(m: Map<V>, k: String) -> V? {
    let i = lower_bound(m.keys, k)
    if i < m.keys.len() && m.keys[i] == k { Some(m.vals[i]) } else { None }
}

fn map_has<V>(m: Map<V>, k: String) -> Bool {
    let i = lower_bound(m.keys, k)
    i < m.keys.len() && m.keys[i] == k
}

fn map_set<V>(m: Map<V>, k: String, v: V) -> Map<V> {
    let i = lower_bound(m.keys, k)
    if i < m.keys.len() && m.keys[i] == k {
        Map { keys: m.keys, vals: m.vals.set(i, v) }
    } else {
        Map { keys: arr_insert(m.keys, i, k), vals: arr_insert(m.vals, i, v) }
    }
}

fn map_remove<V>(m: Map<V>, k: String) -> Map<V> {
    let i = lower_bound(m.keys, k)
    if i < m.keys.len() && m.keys[i] == k {
        Map { keys: m.keys.remove_at(i), vals: m.vals.remove_at(i) }
    } else {
        m
    }
}

fn map_len<V>(m: Map<V>) -> Int {
    m.keys.len()
}

fn map_keys<V>(m: Map<V>) -> [String] {
    m.keys
}

fn map_values<V>(m: Map<V>) -> [V] {
    m.vals
}

fn map_entries<V>(m: Map<V>) -> [(String, V)] {
    var out: [(String, V)] = []
    for i in 0..m.keys.len() {
        out = out.push(Tuple2(m.keys[i], m.vals[i]))
    }
    out
}

fn set_has(s: Set, k: String) -> Bool {
    let i = lower_bound(s.members, k)
    i < s.members.len() && s.members[i] == k
}

fn set_add(s: Set, k: String) -> Set {
    let i = lower_bound(s.members, k)
    if i < s.members.len() && s.members[i] == k {
        s
    } else {
        Set { members: arr_insert(s.members, i, k) }
    }
}

fn set_remove(s: Set, k: String) -> Set {
    let i = lower_bound(s.members, k)
    if i < s.members.len() && s.members[i] == k {
        Set { members: s.members.remove_at(i) }
    } else {
        s
    }
}

fn set_len(s: Set) -> Int {
    s.members.len()
}

fn set_items(s: Set) -> [String] {
    s.members
}

fn set_union(a: Set, b: Set) -> Set {
    var out = a
    for k in b.members {
        out = out.add(k)
    }
    out
}

fn set_intersect(a: Set, b: Set) -> Set {
    Set { members: a.members.filter(|k| b.has(k)) }
}
