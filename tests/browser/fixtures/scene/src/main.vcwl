// Browser-test fixture: 3D scenes with lights, groups, state-bound meshes, clicks, models,
// textures, translucency and shadows.
app "Scene"

component App {
    state hits: Int = 0
    state wire: Bool = false
    state x: Float = -1.6
    state shadows: Bool = false
    state glass: Float = 1.0

    column(gap: 8px) {
        style {
            padding: 16px
        }
        paragraph("Hits: {hits}")
        scene(label: "A box, a sphere and a ring", camera: vec3(0.0, 1.5, 5.0), background: "#15171c", orbit: true) {
            style {
                height: 360px
                radius: 12px
            }
            light(kind: "ambient", intensity: 0.3)
            light(position: vec3(3.0, 5.0, 4.0), intensity: 0.9)
            mesh(shape: "plane", size: vec3(8.0, 1.0, 8.0), position: vec3(0.0, -0.75, 0.0), color: "#2a2f3a")
            mesh(shape: "box", label: "Box", position: vec3(x, 0.0, 0.0), rotation: vec3(20.0, 30.0, 0.0), color: "#d16a47", wireframe: wire) {
                on click {
                    hits += 1
                }
            }
            mesh(shape: "sphere", position: vec3(0.0, 0.0, 0.0), color: "#4f8cff")
            group(position: vec3(1.6, 0.0, 0.0), spin: vec3(0.0, 90.0, 0.0)) {
                mesh(shape: "torus", size: vec3(1.4, 1.4, 1.4), rotation: vec3(90.0, 0.0, 0.0), color: "#b6ff6c")
            }
        }
        row(gap: 8px) {
            button("Wireframe") {
                on click {
                    wire = !wire
                }
            }
            button("Move") {
                on click {
                    x = x + 0.4
                }
            }
            button("Shadows") {
                on click {
                    shadows = !shadows
                }
            }
            button("Fade") {
                on click {
                    glass = 0.3
                }
            }
        }
        scene(label: "Loaded models, a textured box and a glass ball", camera: vec3(0.0, 4.0, 6.0), background: "#15171c", shadows: shadows) {
            style {
                height: 300px
            }
            light(kind: "ambient", intensity: 0.25)
            light(position: vec3(3.0, 3.0, 1.0), intensity: 0.9)
            mesh(shape: "plane", size: vec3(10.0, 1.0, 10.0), position: vec3(0.0, -0.5, 0.0), color: "#8a8f9a", shininess: 0.0)
            mesh(model: "models/pyramid.obj", size: vec3(1.5, 1.5, 1.5), position: vec3(-2.0, 0.0, 0.0), color: "#ffd400")
            mesh(model: "models/tetra.glb", size: vec3(1.4, 1.4, 1.4), position: vec3(2.0, 0.2, 0.0), color: "#00e0a0")
            mesh(shape: "box", texture: "textures/checker.png", position: vec3(0.0, 0.0, -1.0))
            mesh(shape: "sphere", size: vec3(1.2, 1.2, 1.2), position: vec3(0.0, 0.3, 1.5), color: "#20c0ff", opacity: glass)
        }
        scene(label: "A model with two materials", camera: vec3(0.0, 1.0, 3.0), background: "#15171c", shadows: shadows) {
            style {
                height: 180px
            }
            light(kind: "ambient", intensity: 0.3)
            light(kind: "point", position: vec3(-1.5, 1.2, 0.5), intensity: 1.2)
            mesh(shape: "plane", size: vec3(6.0, 1.0, 6.0), position: vec3(0.0, -0.8, 0.0), color: "#8a8f9a", shininess: 0.0)
            mesh(model: "models/materials.glb", size: vec3(2.0, 2.0, 2.0), rotation: vec3(0.0, 20.0, 0.0))
        }
        scene(label: "glTF materials", camera: vec3(0.0, 0.0, 3.5), background: "#000000") {
            style {
                height: 240px
            }
            light(kind: "ambient", intensity: 0.4)
            light(position: vec3(1.0, 1.0, 0.3), intensity: 0.8)
            mesh(model: "models/emissive.glb", position: vec3(-4.0, 0.0, 0.0))
            mesh(model: "models/metal.glb", position: vec3(-2.0, 0.0, 0.0))
            mesh(model: "models/occluded.glb", position: vec3(0.0, 0.0, 0.0))
            mesh(model: "models/plastic.glb", position: vec3(2.0, 0.0, 0.0))
            mesh(model: "models/bumpy.glb", position: vec3(4.0, 0.0, 0.0))
        }
        scene(label: "An animated model", camera: vec3(0.0, 0.0, 6.0), background: "#000000") {
            style {
                height: 120px
            }
            mesh(model: "models/moving.glb")
        }
        scene(label: "Two crossing panes of glass", camera: vec3(0.0, 0.0, 4.0), background: "#000000") {
            style {
                height: 180px
            }
            light(kind: "ambient", intensity: 1.0)
            mesh(shape: "box", size: vec3(3.0, 1.5, 0.01), rotation: vec3(0.0, 35.0, 0.0), color: "#ff0000", opacity: 0.6)
            mesh(shape: "box", size: vec3(3.0, 1.5, 0.01), rotation: vec3(0.0, -35.0, 0.0), color: "#0000ff", opacity: 0.6)
        }
    }
}
