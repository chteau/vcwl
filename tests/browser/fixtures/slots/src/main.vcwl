// Browser-test fixture: components that show content given by their user.
app "Slots"

component Card(title: String) {
    event close

    article {
        heading(title, level: 2)
        slot
        button("Close") {
            on click {
                emit close
            }
        }
    }
}

component Panel {
    section {
        header {
            slot(header)
        }
        slot
        footer {
            slot(footer) {
                text("no footer")
            }
        }
    }
}

// Passes each name to the content its user gives for `row`.
component Names(names: [String]) {
    slot row(String)

    list {
        for s in names key s {
            item {
                slot(row, s)
            }
        }
    }
}

// Unkeyed: rotating the names changes the value each row's content gets.
component Numbered(names: [String]) {
    slot row(String)

    ordered_list {
        for s in names {
            item {
                slot(row, s)
            }
        }
    }
}

// Slots inside `if`, and a slot at the root of a component.
component Fold(open: Bool) {
    if open {
        slot
    }
}

// Forwards its own slot into a Card's.
component Framed {
    Card(title: "framed") {
        slot
    }
}

component App {
    state n: Int = 0
    state open: Bool = true
    state items: [Int] = [1, 2]
    state names: [String] = ["ann", "bob", "cy"]
    state picked: String = "none"
    state shown: Bool = false
    state m: Int = 0

    column {
        if open {
            Card(title: "Counter") {
                paragraph("Count {n}")
                button("Add") {
                    on click {
                        n += 1
                    }
                }
                on close {
                    open = false
                }
            }
        }
        Card(title: "Empty")
        for i in items key i {
            Card(title: "Item {i}") {
                text("n is {n}")
            }
        }
        button("Reverse") {
            on click {
                items = [items[1], items[0]]
            }
        }
        Panel {
            text("body {n}")
            slot(footer) {
                text("foot {n}")
            }
            slot(header) {
                heading("Head", level: 3)
            }
        }
        Panel {
            slot(header) {
                text("only head")
            }
        }
        Names(names: names) {
            slot(row, who) {
                button("{who} {n}") {
                    on click {
                        picked = who
                    }
                }
            }
        }
        paragraph("picked {picked}")
        button("Rotate") {
            on click {
                names = [names[2], names[0], names[1]]
            }
        }
        button("Drop") {
            on click {
                names = [names[0], names[1]]
            }
        }
        Names(names: ["x", "y", "z"]) {
            slot(row, w) {
                text("{w} {n}")
                span("m{m}")
            }
        }
        Numbered(names: names) {
            slot(row, w) {
                text("u {w}")
            }
        }
        button("M") {
            on click {
                m += 1
            }
        }
        Fold(open: shown) {
            text("folded {n}")
        }
        button("Inc") {
            on click {
                n += 1
            }
        }
        Framed {
            text("inside {n}")
        }
        button("Show") {
            on click {
                shown = !shown
            }
        }
    }
}
