// expect: 3
// expect: ab
// expect: 7
// expect: x=1
// expect: y=2
// expect: 4
// expect: 8
// expect: 9
fn pair(a: Int, b: String) -> (Int, String) {
    (a, b)
}

fn sum(t: (Int, Int)) -> Int {
    match t {
        (a, b) => a + b,
    }
}

fn main() {
    let p = pair(3, "ab")
    print("{p.0}")
    print("{p.1}")
    let (a, b) = (3, 4)
    print("{a + b}")
    let items: [(String, Int)] = [("x", 1), ("y", 2),]
    for (k, v) in items {
        print("{k}={v}")
    }
    let n = ((1, 2), 3)
    print("{n.0.1 + n.1 - 1}")
    let ((q, r), s) = n
    print("{q + r + s + 2}")
    print("{sum((4, 5))}")
}
